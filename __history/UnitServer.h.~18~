#define MAX_BUF_SIZE 200000

typedef struct {
	unsigned char bufData[MAX_BUF_SIZE];
	char user_ip[16];
	char user_id[50];
	int pos;
	int len;
	int disconnect;
	int fd;
	TDateTime last_packet_time;
	void *AContext;
	AnsiString A1Strs;
	int user_type;
} SERVER_SOCK_INFO;

typedef struct
{
		int tr_no;
		int len;
		char packet[800];
		TDateTime tm;
} TSisePacket2;

struct PATCH_SOCK_INFO
{
	TThreadList *sendQueue;    // 이 연결 전용 송신 큐 (비동기 전송이 필요할 때만)
	SERVER_SOCK_INFO *ssi;

	PATCH_SOCK_INFO()
    {
		sendQueue = new TThreadList();
		ssi = new  SERVER_SOCK_INFO;
    }
    ~PATCH_SOCK_INFO()
    {
        TList *pList = sendQueue->LockList();
        try
        {
			for (int i = 0; i < pList->Count; i++)
                delete (TSisePacket2*)pList->Items[i];
            pList->Clear();
        }
        __finally { sendQueue->UnlockList(); }
		delete sendQueue;

		if (ssi)
		{
			delete ssi;
			ssi = NULL;
		}
    }
};

