void __fastcall TFormServer::IdTCPServerConnect(TIdContext *AContext)
{
	CHART_SOCK_INFO *csi = new CHART_SOCK_INFO();

	AnsiString strIP = AContext->Connection->Socket->Binding->PeerIP;
	Log("접속 : " + strIP);

	int offsetIdx = GetFD();

	memcpy(csi->ssi->user_ip, strIP.c_str(), sizeof(csi->ssi->user_ip));
	csi->ssi->disconnect = 9;
	csi->ssi->pos = 0;
	csi->ssi->len = 0;
	csi->ssi->last_packet_time = Now();
	csi->ssi->fd = offsetIdx;
	csi->ssi->AContext = (void *)AContext;
	csi->ssi->disconnect = 0;

	AContext->Data = (TObject *)csi;
}
//---------------------------------------------------------------------------

void __fastcall TFormServer::IdTCPServerDisconnect(TIdContext *AContext)
{
	AnsiString strIP = AContext->Connection->Socket->Binding->PeerIP;
	Log("끊김 : " + strIP);

	CHART_SOCK_INFO *csi = (CHART_SOCK_INFO *)AContext->Data;
	if (csi)
	{
		csi->ssi->disconnect = -1;
		memset(csi->ssi->user_id, 0x00, sizeof(csi->ssi->user_id));
		Log("남은 시세버퍼 초기화 : " + strIP);
//		siselist_init(csi->ssi);

		delete csi;
        AContext->Data = NULL;
	}
}
