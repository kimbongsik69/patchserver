void __fastcall TFormServer::Log(AnsiString LogMsg)
{
    AnsiString dateStr = FormatDateTime("yyyymmdd", Now());
    AnsiString Str;
    Str.sprintf("%s %s", AnsiString(FormatDateTime("yyyy-mm-dd hh:nn:ss", Now())).c_str(), LogMsg.c_str());

    // --- 파일 쓰기 (이전과 동일) ---
    LogCS->Enter();
    try
    {
        if (LogFP == NULL || dateStr != CurrentLogDate)
        {
            if (LogFP) { fclose(LogFP); LogFP = NULL; }
            AnsiString path = ExtractFilePath(Application->ExeName) + "log\\" + dateStr;
            ForceDirectories(path);
            AnsiString fn = path + "\\Log.txt";
            LogFP = fopen(fn.c_str(), "a");
            CurrentLogDate = dateStr;
        }
        if (LogFP)
        {
            fprintf(LogFP, "%s\n", Str.c_str());
            fflush(LogFP);
        }
    }
    __finally { LogCS->Leave(); }

    // --- UI 업데이트: 람다 대신 헬퍼 객체 사용 ---
    TLogQueueItem *item = new TLogQueueItem(this, Str);
    TThread::Queue(NULL, item->DoLog);
}
