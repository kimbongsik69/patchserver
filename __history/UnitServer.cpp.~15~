void __fastcall TFormServer::IdTCPServerExecute(TIdContext *AContext)
{
	TIdBytes       SocketReceiveArray;
    int RecieveSize;
	unsigned char  ReceiveDataBuffer[MAX_BUF_SIZE];

	TDateTime nowTime = Now();

	try
	{
		if(AContext->Connection->IOHandler != NULL)
		{
			AContext->Connection->IOHandler->CheckForDisconnect(true, true);
			AContext->Connection->IOHandler->CheckForDataOnSource(10);	//빼면 CPU 100%
			AContext->Connection->CheckForGracefulDisconnect(true);

			RecieveSize = AContext->Connection->IOHandler->InputBuffer->Size;
		}
		else
		{
			Log("핸들값이 없습니다.");
			return;
		}
	}
	catch(const EIdConnClosedGracefully &E)
	{
		Log("정상 종료: " + E.Message);
		return;
	}
	catch(const EIdReadTimeout &E)
	{
		Log("읽기 타임아웃: " + E.Message);
		return;
	}
	catch(const EIdSocketError &E)
	{
		Log("소켓 오류: " + E.ClassName() + " / " + E.Message
			+ " (LastError=" + IntToStr(E.LastError) + ")");
		return;
	}
	catch(const Exception &E)
	{
		// VCL/Indy 계열 예외는 대부분 여기서 잡힘
		Log("핸들 상태 오류: " + E.ClassName() + " / " + E.Message);
		return;
	}
	catch(...)
	{
		// 정말 알 수 없는(비 C++Builder Exception 계열) 예외
		Log("알 수 없는 예외 (Exception 계열 아님)");
		return;
	}

	CHART_SOCK_INFO *csi = (CHART_SOCK_INFO *)AContext->Data;
	if (!csi) return;

	if (RecieveSize >= 1)
	{
		try
		{
			AContext->Connection->IOHandler->ReadBytes(SocketReceiveArray, RecieveSize, false);
		}
		catch (EIdConnClosedGracefully &E)
		{
			AContext->Connection->IOHandler->InputBuffer->Clear();
			AContext->Connection->Disconnect();
			Log("클라이언트 종료로 메시지를 보낼 수 없습니다.");
			return;
		}

		if(RecieveSize > MAX_BUF_SIZE) RecieveSize = MAX_BUF_SIZE;
		BytesToRaw(SocketReceiveArray, &ReceiveDataBuffer, RecieveSize);

		try
		{
			if (csi->ssi->len + RecieveSize > MAX_BUF_SIZE)
			{
				Log("Warning: Buffer Full! Clearing data.");
				csi->ssi->pos = 0;
			}

			int trSize = SZ_QUERY_HEADER;
            int hdSize = sizeof(short) - 1;

			for(int i = 0; i < RecieveSize; i++)
			{
				csi->ssi->bufData[csi->ssi->pos] = SocketReceiveArray[i];

				int confirm = -1;

				if (csi->ssi->pos >= trSize - 1)
				{
					QUERY_HEADER header;
					memcpy(&header, csi->ssi->bufData, SZ_QUERY_HEADER);
					int tr_no = header.packet_type;

					unsigned char ff = csi->ssi->bufData[csi->ssi->pos-2];
					unsigned char cr = csi->ssi->bufData[csi->ssi->pos-1];
					unsigned char lf = csi->ssi->bufData[csi->ssi->pos];

					if (ff == 0xff && cr == 0x0d && lf == 0x0a)
					{
						if(csi->ssi->pos != header.total_size - 1)
						{
							Log("패킷 사이즈가 틀립니다. POS = " + IntToStr(csi->ssi->pos) + ", TR = " + IntToStr(tr_no) + ", TotalSize = " + IntToStr(header.total_size));
						}

						Process_PACKET(&header, csi->ssi->bufData + SZ_QUERY_HEADER, AContext);

						csi->ssi->pos = 0;
						ZeroMemory(csi->ssi->bufData, sizeof(csi->ssi->bufData));
						confirm = 0;
					}
				}

				if(confirm < 0) csi->ssi->pos++;
			}	//end for

			if(csi->ssi->pos != 0)
			{
				Log("패킷을 분할로 받았습니다. size : " + IntToStr(RecieveSize));
			}
		}
		catch(const Exception& E)
		{
			Log(E.Message);
		}
		catch(...)
		{
			Log("packet receive");
		}
	}

	// --- 송신 큐 처리: 큐에 있는 건 다 비우고 다음 루프로 넘어감 (여기서 대기 X) ---
//	CHART_SOCK_INFO *csi = (CHART_SOCK_INFO *)AContext->Data;
//	if (!csi) return;

	TList *pList = csi->sendQueue->LockList();
    try
    {
        while (pList->Count > 0)
        {
            TSisePacket2 *pk = (TSisePacket2 *)pList->Items[0];

			if(pk->len > 0 && csi->ssi->disconnect == 0){
				TIdBytes Buffer;
				Buffer = RawToBytes((byte *)pk->packet, pk->len);
				try
				{
					AContext->Connection->IOHandler->Write(Buffer);

				}
				catch(EIdConnClosedGracefully &E)
				{
					Log("EIdConnClosedGracefully : " + AnsiString(E.Message) + ", IP:" + AnsiString(csi->ssi->user_ip));
					break;
				}
				catch(EIdClosedSocket &E)
				{
					csi->ssi->disconnect = -1;
					Log("EIdClosedSocket : " + AnsiString(E.Message) + ", IP:" + AnsiString(csi->ssi->user_ip));
					break;
				}
				catch(EIdSocketError &E)
				{
					csi->ssi->disconnect = -1;
					Log("EIdSocketError : " + AnsiString(E.Message) + ", IP:" + AnsiString(csi->ssi->user_ip) + ", TR : " + AnsiString(pk->tr_no));
					break;
				}
				catch(EIdException &E)
				{
					csi->ssi->disconnect = -1;
					Log("EIdException : " + AnsiString(E.Message) + ", IP:" + AnsiString(csi->ssi->user_ip));
					break;
				}
				catch(...)
				{
					csi->ssi->disconnect = -1;
					Log("비정상 소켓오류, IP:" + AnsiString(csi->ssi->user_ip));
					break;
				}
			}
            delete pk;              // 여기서만 delete → 소유권 명확
			pList->Delete(0);
        }
    }
	__finally { csi->sendQueue->UnlockList(); }

	if (nowTime > IncSecond(csi->ssi->last_packet_time, 2))
	{
		Log("체크시간 초과..." + AnsiString(csi->ssi->user_id) + "현재시간:" + nowTime.DateTimeString() + "마지막 패킷:" + csi->ssi->last_packet_time.DateTimeString());

		if(IdForceClose(31, AContext) < 0)
		{
			//main에있는 clientlist를 지워준다.
		}

	}
