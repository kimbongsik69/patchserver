class TLogQueueItem
{
public:
    TFormServer *Form;
    AnsiString   Str;

    TLogQueueItem(TFormServer *AForm, AnsiString AStr)
        : Form(AForm), Str(AStr) {}

    void __fastcall DoLog()
    {
        Form->Memo1->Lines->Add(Str);          // 맨 아래에 추가
        Form->Memo1->SelStart = Form->Memo1->GetTextLen(); // 커서를 끝으로
        Form->Memo1->SelLength = 0;
        Form->Memo1->Perform(EM_SCROLLCARET, 0, 0); // 최신 줄로 자동 스크롤
        delete this;
    }
};

