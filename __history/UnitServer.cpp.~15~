void __fastcall TFormServer::IdTCPServerException(TIdContext *AContext, Exception *AException)

{
	AnsiString strIP = AContext->Connection->Socket->Binding->PeerIP;
	AnsiString strMsg = "";

	int ErrorCode = ((EIdSocketError *)AException)->LastError;

	switch(ErrorCode)
	{
		case 10050: strMsg = "네트워크가 다운되었습니다."; break;
		case 10051: strMsg = "네트워크에 도달할 수 없습니다."; break;
		case 10054: strMsg = "서버에서 강제로 연결을 종료하였습니다."; break;
		case 10060: strMsg = "서버에 연결 시도중 타임아웃되었습니다."; break;
		case 10061: strMsg = "서버에 연결할 수 없습니다."; break;
		case 10064: strMsg = "서버가 다운되었습니다."; break;
		case 10091: strMsg = "현재 시스템에 네트워크가 존재하지 않습니다."; break;
		default:    strMsg = "알 수 없는 소켓 에러입니다.";
	}

	Log("IdTCPServerException" + IntToStr(ErrorCode) + strIP + ":" + strMsg);
}
